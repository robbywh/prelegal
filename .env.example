# Copy this file to .env and fill in real values. .env is gitignored.

# Used by the AI chat feature (LiteLLM via OpenRouter, Cerebras inference provider).
OPENROUTER_API_KEY=

# Used to sign auth JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
